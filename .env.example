VECTOR_STORE_TYPE=chroma
CHROMA_PERSIST_DIR=data/chroma
CHROMA_COLLECTION_NAME=rust_book
BM25_PERSIST_DIR=data/bm25
# SEARCH_MODE=semantic
# CANDIDATE_K=20
# RERANK_ENABLED=false
# RERANK_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
# EMBEDDING_TYPE=chroma_default
# EMBEDDING_MODEL=all-MiniLM-L6-v2
# INGEST_SOURCE_DIR=corpora/rust-book/src
# INGEST_SOURCE_DIR=data/download/rust-book/src
# INGEST_SKIP_FILES=SUMMARY.md,title-page.md
# INGEST_ON_STARTUP=true

PHOENIX_ENABLED=false
PHOENIX_COLLECTOR_ENDPOINT=http://localhost:4317
PHOENIX_PROJECT_NAME=agentic-doc

# Shared LLM credentials (agent run_workflow / Doc Agent studio; also usable for explorer eval --llm)
# LLM_API_KEY=sk-...
# LLM_BASE_URL=https://openrouter.ai/api/v1
# Gemini AI Studio (OpenAI-compatible):
# LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/

# Agent model settings (packages/agent + apps/studio — default model is gpt-4o-mini if unset)
# LLM_MODEL=openai/gpt-4o-mini
# LLM_MODEL=gemini-2.0-flash
# LLM_TEMPERATURE=0.0
# PLAN_ENABLED=true
# MAX_TOOL_ROUNDS=5
# DEFAULT_TOP_K=5
# FAITHFULNESS_ENABLED=true
# Note: EVAL_LLM_MODEL below is only for explorer eval --llm, not studio/agent.
# EVAL_TOP_K=5
# EVAL_REPORT_DIR=data/eval/reports
# EVAL_DATASET_PATH=packages/rag/src/agentic_doc_rag/evaluation/datasets/rust_book.jsonl
# EVAL_FAIL_UNDER_HIT_AT_K=0.70
# EVAL_LLM_MODEL=gpt-4o-mini
# EVAL_LLM_CONCURRENCY=5
# EVAL_PHOENIX_CLIENT_URL=http://localhost:6006
